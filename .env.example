# --- Database (Turso / libSQL). Required on Vercel. Leave empty locally to use data/chronicle.db ---
TURSO_DATABASE_URL=libsql://chogchronicle-<your-org>.turso.io
TURSO_AUTH_TOKEN=
# Local file fallback path (dev only)
# DB_PATH=data/chronicle.db

# --- Game ---
# 1 = allow unsigned demo actions for demo Chogs 1, 69, 777 (per-visitor energy). 0 = wallet-only.
DEMO_MODE=1
# Protects POST /api/admin/reset (demo mode only). CHANGE THIS in production.
ADMIN_TOKEN=change-me
# Optional custom Monad RPC (default https://rpc.monad.xyz)
# MONAD_RPC=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/tick (set it in Vercel; Hobby = daily, catch-up ticks run lazily on requests anyway)
CRON_SECRET=
# Optional: address that receives on-chain $CHOG bounty payments (enables wallet-mode bounties)
# TREASURY_ADDRESS=0x...
